  const embedUrl = getEmbedUrl(url);

  if (!url) return null;

  return (
    <div className={`rp-ecs-video-embed ${className}`} style={style}>
      {embedUrl ? (
        <iframe
          src={embedUrl}
          data-testid="video-embed-iframe"
